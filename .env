# ============================================================
# KEY SERVER - BIẾN MÔI TRƯỜNG ĐẦY ĐỦ
# Tác giả: MADE BY Bao Huy
# Sao chép thành .env, điền giá trị thật, KHÔNG commit lên Git
# ============================================================

# ============================================================
# 1. BẮT BUỘC - PHẢI ĐIỀN
# ============================================================

# Token bot Telegram lấy từ @BotFather
# Cách lấy: chat @BotFather -> /newbot -> sao chép token
BOT_TOKEN=6190734534:AAFE2Y1VlLBUv_W3EMwwQ3TkKmMSJWzrHJc

# ID Telegram của admin, nhiều ID cách nhau dấu phẩy
# Cách lấy: chat @userinfobot -> sao chép Id
ADMIN_IDS=5736655322

# Token quản trị dùng cho header X-Admin-Token trong API
# Sinh: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=admin_token_thay_bang_chuoi_ngau_nhien_32_ky_tu_tro_len

# Khóa bí mật cho Flask session, dùng để ký cookie
# Sinh: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=secret_key_thay_bang_chuoi_ngau_nhien_32_ky_tu_tro_len

# ============================================================
# 2. CƠ BẢN
# ============================================================

# Cổng chạy web server (Render tự set, local để 3000)
PORT=3000

# Thư mục lưu database, log, session
# Local: ./data
# Render: /opt/render/project/src/data
DATA_DIR=./data

# Phiên bản ứng dụng, hiển thị ở API health
APP_VERSION=1.0.0

# Chế độ debug, chỉ bật khi phát triển local
DEBUG=false

# Môi trường: development, staging, production
ENV=production

# ============================================================
# 3. KEY MẶC ĐỊNH
# ============================================================

# Số ngày hiệu lực mặc định khi tạo key mới
DEFAULT_DAYS=30

# Số thiết bị tối đa mặc định cho một key
DEFAULT_MAX_DEVICES=1

# Bật/tắt tự động cấp key qua lệnh /code trên bot
AUTO_ISSUE_ENABLED=true

# Chỉ cấp key một lần cho mỗi user (true) hay cấp lại nếu hết hạn (false)
AUTO_ISSUE_ONCE=true

# Số ngày tối đa một key có thể được gia hạn
MAX_KEY_DAYS=3650

# Số thiết bị tối đa cho một key
MAX_DEVICES_PER_KEY=100

# ============================================================
# 4. CTV (CỘNG TÁC VIÊN)
# ============================================================

# Số ngày tối đa CTV được phép tạo key
CTV_MAX_DAYS=30

# Số key tối đa CTV được phép tạo
CTV_MAX_KEYS=50

# Bật/tắt chức năng CTV
CTV_ENABLED=true

# ============================================================
# 5. API KEY CHO CLIENT
# ============================================================

# Tiền tố cho API key sinh ra (vd: ks_xxx)
APIKEY_PREFIX=ks

# Số API key tối đa trong hệ thống
APIKEY_MAX_KEYS=1000

# Scope mặc định khi tạo API key mới
APIKEY_DEFAULT_SCOPES=verify,info

# Rate limit mặc định cho API key (request/phút)
APIKEY_DEFAULT_RATE=60

# ============================================================
# 6. TELEGRAM BOT
# ============================================================

# Chế độ chạy bot: true = webhook, false = polling
# Render free tier nên dùng polling (false)
USE_WEBHOOK=false

# Secret token cho webhook, Telegram yêu cầu 32+ ký tự
# Chỉ dùng khi USE_WEBHOOK=true
WEBHOOK_SECRET=webhook_secret_thay_bang_chuoi_ngau_nhien_32_ky_tu

# URL công khai của service, Render tự set khi deploy web service
# Local để trống
RENDER_EXTERNAL_URL=

# Delay giữa các tin nhắn broadcast (giây), tránh bị Telegram chặn
BROADCAST_DELAY=0.05

# Số tin nhắn tối đa mỗi giây gửi qua Telegram
TELEGRAM_MAX_RATE=25

# Timeout gọi Telegram API (giây)
TELEGRAM_TIMEOUT=15

# ============================================================
# 7. BẢO MẬT
# ============================================================

# Bật secure cookie (chỉ true khi có HTTPS)
COOKIE_SECURE=true

# Thời gian sống session (giây), mặc định 7 ngày
SESSION_TTL=604800

# Số lần đăng nhập sai tối đa trước khi khóa
MAX_LOGIN_ATTEMPTS=5

# Thời gian khóa tài khoản sau khi sai quá nhiều (giây)
LOGIN_LOCKOUT_TIME=900

# Bật kiểm tra CSRF cho form web
CSRF_ENABLED=true

# Bật kiểm tra User-Agent khi verify key
VERIFY_CHECK_UA=false

# Bật kiểm tra IP khi verify key
VERIFY_CHECK_IP=false

# ============================================================
# 8. RATE LIMIT
# ============================================================

# Số request mặc định mỗi phút cho toàn hệ thống
RATE_LIMIT_DEFAULT=300

# Số request đăng nhập mỗi phút
RATE_LIMIT_LOGIN=5

# Số request đăng ký mỗi phút
RATE_LIMIT_REGISTER=3

# Số request verify key mỗi phút
RATE_LIMIT_VERIFY=60

# Số request tạo key mỗi phút
RATE_LIMIT_CREATE_KEY=10

# Storage cho rate limit: memory:// hoặc redis://...
RATE_LIMIT_STORAGE=memory://

# ============================================================
# 9. LOG
# ============================================================

# Mức log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Số bản ghi log hệ thống tối đa giữ lại
LOG_MAX_ENTRIES=10000

# Số bản ghi log API tối đa giữ lại
API_LOG_MAX_ENTRIES=10000

# Bật ghi log ra file
LOG_TO_FILE=false

# Đường dẫn file log
LOG_FILE=./logs/app.log

# ============================================================
# 10. DATABASE
# ============================================================

# Đường dẫn SQLite (mặc định trong DATA_DIR)
DB_FILE=keyserver.db

# Bật WAL mode cho SQLite
DB_WAL=true

# Timeout kết nối SQLite (giây)
DB_TIMEOUT=30

# Kích thước cache SQLite (KB, âm = KB, dương = pages)
DB_CACHE_SIZE=-20000

# ============================================================
# 11. CACHE
# ============================================================

# Số mục tối đa trong cache in-memory
CACHE_MAX_SIZE=5000

# TTL mặc định cho cache (giây)
CACHE_DEFAULT_TTL=60

# TTL cho stats cache
CACHE_STATS_TTL=30

# TTL cho session cache
CACHE_SESSION_TTL=60

# ============================================================
# 12. THÔNG BÁO
# ============================================================

# Bật thông báo cho admin qua Telegram
NOTIFY_ADMIN=true

# Bật thông báo khi key sắp hết hạn
NOTIFY_EXPIRING=true

# Số ngày trước hết hạn để thông báo (cách nhau dấu phẩy)
NOTIFY_EXPIRING_DAYS=7,3,1

# Bật thông báo khi có thiết bị mới
NOTIFY_NEW_DEVICE=false

# Bật thông báo khi login
NOTIFY_LOGIN=false

# ============================================================
# 13. WEB
# ============================================================

# Tiêu đề hiển thị trên web
WEB_TITLE=Key Server

# Số mục mỗi trang trong danh sách key
WEB_PAGE_SIZE=50

# Theme mặc định: dark, light
WEB_THEME=dark

# Bật hiển thị log trên dashboard
WEB_SHOW_LOGS=true

# Số log hiển thị trên dashboard
WEB_DASHBOARD_LOGS=20

# ============================================================
# 14. TÍCH HỢP BÊN NGOÀI (tùy chọn)
# ============================================================

# Redis cho cache và rate limit (để trống nếu không dùng)
REDIS_URL=

# Sentry DSN cho error tracking (để trống nếu không dùng)
SENTRY_DSN=

# Google Analytics ID (để trống nếu không dùng)
GA_ID=

# Webhook Discord thông báo (để trống nếu không dùng)
DISCORD_WEBHOOK=

# ============================================================
# 15. BACKUP
# ============================================================

# Bật tự động backup
BACKUP_ENABLED=false

# Thư mục lưu backup
BACKUP_DIR=./backups

# Số ngày giữ backup
BACKUP_KEEP_DAYS=7

# Giờ chạy backup mỗi ngày (0-23)
BACKUP_HOUR=3

# ============================================================
# 16. CRON & WORKER
# ============================================================

# Chu kỳ kiểm tra key hết hạn (giây)
CRON_CHECK_INTERVAL=3600

# Chu kỳ dọn session (giây)
CLEANUP_SESSION_INTERVAL=600

# Chu kỳ dọn log API (giây)
CLEANUP_LOG_INTERVAL=3600

# Chu kỳ flush notify queue (giây)
NOTIFY_FLUSH_INTERVAL=10
