# ============================================================
# KEY SERVER - MẪU BIẾN MÔI TRƯỜNG
# Tác giả: MADE BY Bao Huy
# Sao chép thành .env và điền giá trị thật
# ============================================================

# ---------------- BẮT BUỘC ----------------
BOT_TOKEN=
ADMIN_IDS=
ADMIN_TOKEN=
SECRET_KEY=

# ---------------- CƠ BẢN ----------------
PORT=3000
DATA_DIR=./data
APP_VERSION=1.0.0
DEBUG=false
ENV=production

# ---------------- KEY MẶC ĐỊNH ----------------
DEFAULT_DAYS=30
DEFAULT_MAX_DEVICES=1
AUTO_ISSUE_ENABLED=true
AUTO_ISSUE_ONCE=true
MAX_KEY_DAYS=3650
MAX_DEVICES_PER_KEY=100

# ---------------- CTV ----------------
CTV_MAX_DAYS=30
CTV_MAX_KEYS=50
CTV_ENABLED=true

# ---------------- API KEY ----------------
APIKEY_PREFIX=ks
APIKEY_MAX_KEYS=1000
APIKEY_DEFAULT_SCOPES=verify,info
APIKEY_DEFAULT_RATE=60

# ---------------- TELEGRAM BOT ----------------
USE_WEBHOOK=false
WEBHOOK_SECRET=
RENDER_EXTERNAL_URL=
BROADCAST_DELAY=0.05
TELEGRAM_MAX_RATE=25
TELEGRAM_TIMEOUT=15

# ---------------- BẢO MẬT ----------------
COOKIE_SECURE=true
SESSION_TTL=604800
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900
CSRF_ENABLED=true
VERIFY_CHECK_UA=false
VERIFY_CHECK_IP=false

# ---------------- RATE LIMIT ----------------
RATE_LIMIT_DEFAULT=300
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=3
RATE_LIMIT_VERIFY=60
RATE_LIMIT_CREATE_KEY=10
RATE_LIMIT_STORAGE=memory://

# ---------------- LOG ----------------
LOG_LEVEL=INFO
LOG_MAX_ENTRIES=10000
API_LOG_MAX_ENTRIES=10000
LOG_TO_FILE=false
LOG_FILE=./logs/app.log

# ---------------- DATABASE ----------------
DB_FILE=keyserver.db
DB_WAL=true
DB_TIMEOUT=30
DB_CACHE_SIZE=-20000

# ---------------- CACHE ----------------
CACHE_MAX_SIZE=5000
CACHE_DEFAULT_TTL=60
CACHE_STATS_TTL=30
CACHE_SESSION_TTL=60

# ---------------- THÔNG BÁO ----------------
NOTIFY_ADMIN=true
NOTIFY_EXPIRING=true
NOTIFY_EXPIRING_DAYS=7,3,1
NOTIFY_NEW_DEVICE=false
NOTIFY_LOGIN=false

# ---------------- WEB ----------------
WEB_TITLE=Key Server
WEB_PAGE_SIZE=50
WEB_THEME=dark
WEB_SHOW_LOGS=true
WEB_DASHBOARD_LOGS=20

# ---------------- TÍCH HỢP NGOÀI ----------------
REDIS_URL=
SENTRY_DSN=
GA_ID=
DISCORD_WEBHOOK=

# ---------------- BACKUP ----------------
BACKUP_ENABLED=false
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=7
BACKUP_HOUR=3

# ---------------- CRON & WORKER ----------------
CRON_CHECK_INTERVAL=3600
CLEANUP_SESSION_INTERVAL=600
CLEANUP_LOG_INTERVAL=3600
NOTIFY_FLUSH_INTERVAL=10
