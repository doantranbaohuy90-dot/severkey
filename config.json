# ---------------- TELEGRAM INFO ----------------

def get_telegram_info():
    import requests
    info = {
        "webhook_set": False, "webhook_url": None, "pending_updates": 0,
        "getme_ok": False, "getme_error": None, "bot_username": None,
        "render_url": os.environ.get("RENDER_EXTERNAL_URL"),
        "token_preview": (BOT_TOKEN[:10] + "...") if BOT_TOKEN else "THIẾU",
        "admin_ids": ", ".join(
            x.strip() for x in os.environ.get("ADMIN_IDS", "").split(",") if x.strip()
        ),
    }
    if not BOT_TOKEN:
        return info
    try:
        r = requests.get(f"{API_TG}/getWebhookInfo", timeout=10)
        if r.status_code == 200:
            d = r.json().get("result", {})
            info["webhook_url"] = d.get("url")
            info["webhook_set"] = bool(d.get("url"))
            info["pending_updates"] = d.get("pending_update_count", 0)
    except Exception as e:
        info["getme_error"] = str(e)
    try:
        r = requests.get(f"{API_TG}/getMe", timeout=10)
        if r.status_code == 200 and r.json().get("ok"):
            info["getme_ok"] = True
            info["bot_username"] = r.json()["result"].get("username")
        else:
            info["getme_error"] = r.text[:120]
    except Exception as e:
        info["getme_error"] = str(e)
    return info

# ---------------- WEB ACTIONS ----------------

@web_bp.route("/web/create", methods=["POST"])
@require_login("write")
def web_create():
    days = int(request.form.get("days", 30))
    owner = request.form.get("owner", "unknown")
    max_dev = int(request.form.get("max_devices", DEFAULT_MAX_DEVICES))
    parent = request.form.get("parent", "").strip() or None
    me = current_user()
    keymod.create_key(days, owner, max_dev,
                      created_by=me["username"], parent_key=parent)
    cache_clear("stats")
    append_log("key_create", {"owner": owner, "by": me["username"]})
    return redirect(request.referrer or url_for("web.index"))

@web_bp.route("/web/issue", methods=["POST"])
@require_login("issue")
def web_issue():
    user_id = request.form.get("user_id", "").strip()
    if not user_id:
        return redirect(request.referrer or url_for("web.index"))
    days = int(request.form.get("days", DEFAULT_DAYS))
    owner = request.form.get("owner", "").strip() or f"user_{user_id}"
    max_dev = int(request.form.get("max_devices", DEFAULT_MAX_DEVICES))
    me = current_user()
    users = keymod.read_json(
        os.path.join(keymod.DATA_DIR, "users.json"), {}
    )
    k, exp, sig = keymod.create_key(days, owner, max_dev,
                                     user_id=user_id, created_by=me["username"])
    users[str(user_id)] = {"key": k, "owner": owner, "createdAt": now_ms()}
    keymod.write_json(os.path.join(keymod.DATA_DIR, "users.json"), users)
    cache_clear("stats")
    return redirect(request.referrer or url_for("web.index"))

@web_bp.route("/web/lookup", methods=["POST"])
@require_login("read")
def web_lookup():
    user_id = request.form.get("user_id", "").strip()
    users = keymod.read_json(os.path.join(keymod.DATA_DIR, "users.json"), {})
    key = users.get(str(user_id), {}).get("key")
    lookup = None
    if key:
        info = keymod.get_key_info(key)
        if info:
            lookup = {
                "user_id": user_id, "key": key, "owner": info["owner"],
                "expiresAt": info["expiresAtText"], "daysLeft": info["daysLeft"],
                "devicesUsed": info["devicesUsed"], "maxDevices": info["maxDevices"],
            }
    logs = keymod.read_json(keymod.LOG_FILE, [])[-20:]
    logs.reverse()
    body = render_template_string(
        DASHBOARD_BODY, me=current_user(), s=compute_stats(), logs=logs,
        lookup=lookup, default_days=DEFAULT_DAYS,
        default_max_devices=DEFAULT_MAX_DEVICES,
    )
    return page("Dashboard", current_user(), body, "dashboard")

