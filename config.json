    items = []
    for k, devs in devices_map.items():
        for dev_id, info in devs.items():
            items.append({
                "device_id": dev_id, "key": k, "ip": info.get("ip"),
                "firstSeenText": fmt_time(info.get("firstSeen", 0)),
