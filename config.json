@web_bp.route("/web/tree/attach", methods=["POST"])
@require_login("write")
def web_tree_attach():
    key = request.form.get("key", "").strip()
    parent = request.form.get("parent", "").strip()
    keys = keymod.load_keys()
    if key in keys and parent in keys:
        keys[key]["parent"] = parent
        keymod.save_keys(keys)
        try:
            keymod.remove_tree_node(key)
            keymod.add_tree_node(key, parent_key=parent,
                                 owner=keys[key].get("owner"))
        except Exception:
            pass
    return redirect(url_for("web.tree"))

@web_bp.route("/web/tree/detach", methods=["POST"])
@require_login("write")
def web_tree_detach():
    key = request.form.get("key", "").strip()
    keys = keymod.load_keys()
    if key in keys:
        keys[key]["parent"] = None
        keymod.save_keys(keys)
        try:
            keymod.remove_tree_node(key)
            keymod.add_tree_node(key, parent_key=None,
                                 owner=keys[key].get("owner"))
        except Exception:
            pass
    return redirect(url_for("web.tree"))

@web_bp.route("/web/addctv", methods=["POST"])
@require_login("ctv")
def web_addctv():
    user_id = request.form.get("user_id", "").strip()
    if user_id:
        ctv_file = os.path.join(keymod.DATA_DIR, "ctv.json")
        ctv = keymod.read_json(ctv_file, {})
        ctv[user_id] = {
            "name": request.form.get("name", "").strip() or f"ctv_{user_id}",
            "maxKeys": int(request.form.get("max_keys", CTV_MAX_KEYS)),
            "maxDays": int(request.form.get("max_days", CTV_MAX_DAYS)),
            "keysCreated": ctv.get(user_id, {}).get("keysCreated", 0),
            "addedAt": now_ms(),
            "active": True,
        }
        keymod.write_json(ctv_file, ctv)
        cache_clear("stats")
    return redirect(url_for("web.ctv_page"))

@web_bp.route("/web/removectv", methods=["POST"])
@require_login("ctv")
def web_removectv():
    user_id = request.form.get("user_id", "").strip()
    ctv_file = os.path.join(keymod.DATA_DIR, "ctv.json")
    ctv = keymod.read_json(ctv_file, {})
    if user_id in ctv:
        del ctv[user_id]
        keymod.write_json(ctv_file, ctv)
        cache_clear("stats")
    return redirect(url_for("web.ctv_page"))

@web_bp.route("/web/toggle_ctv", methods=["POST"])
@require_login("ctv")
def web_toggle_ctv():
    user_id = request.form.get("user_id", "").strip()
    ctv_file = os.path.join(keymod.DATA_DIR, "ctv.json")
    ctv = keymod.read_json(ctv_file, {})
    if user_id in ctv:
        ctv[user_id]["active"] = not ctv[user_id].get("active", True)
        keymod.write_json(ctv_file, ctv)
    return redirect(url_for("web.ctv_page"))

@web_bp.route("/accounts/create", methods=["POST"])
@require_login("admin")
def accounts_create():
    u = request.form.get("username", "").strip()
    p = request.form.get("password", "")
    ok, err = authmod.register_account(u, p)
    if ok:
        uid, _ = authmod.find_account_by_username(u)
        if uid:
            authmod.set_account_role(uid, request.form.get("role", "viewer"))
        return redirect(url_for("web.accounts_page"))
    return redirect(url_for("web.accounts_page", error=err))

@web_bp.route("/accounts/remove", methods=["POST"])
@require_login("admin")
def accounts_remove():
    u = request.form.get("username", "")
    uid, _ = authmod.find_account_by_username(u)
    me = current_user()
    if uid and me and u != me["username"]:
        authmod.delete_account(uid)
    return redirect(url_for("web.accounts_page"))

