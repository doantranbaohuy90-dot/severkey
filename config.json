# ---------------- TIỆN ÍCH ----------------

def now_ms():
    return int(time.time() * 1000)

def fmt_time(ms):
    try:
        return datetime.fromtimestamp(ms / 1000).strftime("%Y-%m-%d %H:%M:%S")
    except Exception:
        return "-"

def get_client_ip(req):
    fwd = req.headers.get("X-Forwarded-For", "")
    if fwd:
        return fwd.split(",")[0].strip()
    return req.remote_addr or "unknown"

def append_log(event, data=None):
    try:
        keymod.append_log(event, data or {})
    except Exception as e:
        print(f"[WEB] append_log lỗi: {e}")

def cache_clear(prefix=None):
    try:
        from cache import cache_clear as _cc
        _cc(prefix)
    except Exception:
        pass

def compute_stats():
    try:
        from cache import cache_get, cache_set
        s = cache_get("stats")
        if s:
            return s
    except Exception:
        cache_get = cache_set = None
    keys = keymod.load_keys()
    devices = keymod.load_devices()
    blocked = keymod.load_blocked()
    accounts = authmod.load_accounts()
    try:
        ctv = keymod.read_json(os.path.join(keymod.DATA_DIR, "ctv.json"), {})
    except Exception:
        ctv = {}
    s = {
        "totalKeys": len(keys),
        "activeKeys": sum(1 for v in keys.values() if v.get("active")),
        "expiredKeys": sum(1 for v in keys.values() if now_ms() > v.get("expiresAt", 0)),
        "totalDevices": sum(len(v) for v in devices.values()),
        "totalUsers": len(accounts),
        "totalCtv": len(ctv),
        "blockedKeys": len(blocked.get("keys", {})),
        "blockedDevices": len(blocked.get("devices", {})),
    }
    try:
        if cache_set:
            cache_set("stats", s, ttl=30)
    except Exception:
        pass
    return s

# ---------------- AUTH ----------------

def current_user():
    token = request.cookies.get("session")
    if not token:
        return None
    try:
        from cache import cache_get
        me = cache_get(f"session:{token}")
        if me:
            return me
    except Exception:
        pass
    s = authmod.get_session(token)
    if not s:
        return None
    rec = authmod.load_accounts().get(s["uid"])
    if not rec or not rec.get("active", True):
        return None
    me = {"uid": s["uid"], "username": rec["username"], "role": rec.get("role", "user")}
    try:
        from cache import cache_set
        cache_set(f"session:{token}", me, ttl=60)
    except Exception:
        pass
    return me

def require_login(perm=None):
    def deco(f):
        @wraps(f)
        def wrapper(*args, **kwargs):
            me = current_user()
            if not me:
                return redirect(url_for("web.login"))
            if perm and not authmod.has_permission(me["role"], perm):
                return make_response("Không có quyền.", 403)
            return f(*args, **kwargs)
        return wrapper
    return deco

def require_admin_token(f):
    @wraps(f)
    def wrapper(*args, **kwargs):
        if request.headers.get("X-Admin-Token") != ADMIN_TOKEN:
            return jsonify({"ok": False, "error": "unauthorized"}), 401
        return f(*args, **kwargs)
    return wrapper

