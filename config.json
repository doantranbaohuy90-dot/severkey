# ---------------- TELEGRAM ACTIONS ----------------

@web_bp.route("/telegram/set-webhook", methods=["POST"])
@require_login("admin")
def telegram_set_webhook():
    import requests
    url = os.environ.get("RENDER_EXTERNAL_URL")
    if url and BOT_TOKEN:
        webhook_url = f"{url}/webhook/{BOT_TOKEN}"
        try:
            requests.get(f"{API_TG}/setWebhook", params={
                "url": webhook_url,
                "drop_pending_updates": "true",
                "allowed_updates": json.dumps(["message", "callback_query"]),
            }, timeout=15)
        except Exception as e:
            print(f"[WEB] setWebhook lỗi: {e}")
    return redirect(url_for("web.telegram_page"))

@web_bp.route("/telegram/delete-webhook", methods=["POST"])
@require_login("admin")
def telegram_delete_webhook():
    import requests
    if BOT_TOKEN:
        try:
            requests.get(f"{API_TG}/deleteWebhook",
                         params={"drop_pending_updates": "true"}, timeout=15)
        except Exception as e:
