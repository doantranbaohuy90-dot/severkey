# ---------------- MY ACTIONS ----------------

@web_bp.route("/my/getkey", methods=["POST"])
def my_getkey():
    me = current_user()
    if not me:
        return redirect(url_for("web.login"))
    rec = authmod.get_account(me["uid"])
    existing = rec.get("key") if rec else None
    if existing:
        kr = keymod.load_keys().get(existing)
        if kr and kr.get("active") and now_ms() < kr["expiresAt"]:
            return redirect(url_for("web.my_panel"))
    user_id = f"web_{me['uid']}"
    owner = rec["username"] if rec else me["username"]
    k, exp, sig = keymod.create_key(
        DEFAULT_DAYS, owner, DEFAULT_MAX_DEVICES,
        user_id=user_id, account_uid=me["uid"],
    )
    try:
        authmod.set_account_key(me["uid"], k)
    except Exception:
        pass
    cache_clear("stats")
    return redirect(url_for("web.my_panel"))

@web_bp.route("/my/changepw", methods=["POST"])
def my_changepw():
    me = current_user()
    if not me:
        return redirect(url_for("web.login"))
    ok, err = authmod.change_account_password(
        me["uid"],
        request.form.get("old_password", ""),
        request.form.get("new_password", ""),
    )
    if not ok:
        return redirect(url_for("web.my_panel", error={
            "not_found": "Không tìm thấy tài khoản.",
            "wrong_password": "Mật khẩu cũ không đúng.",
            "too_short": "Mật khẩu mới quá ngắn.",
        }.get(err, "Lỗi.")))
    return redirect(url_for("web.my_panel", success="Đã đổi mật khẩu."))

# ---------------- ĐĂNG KÝ BLUEPRINT ----------------

def register(app):
    """Đăng ký blueprint vào Flask app."""
    app.register_blueprint(web_bp)
    return web_bp
