# ---------------- API MANAGER ----------------

@web_bp.route("/api")
def api_manager():
    me = current_user()
    if not me or me["role"] != "admin":
        return make_response("Không có quyền.", 403)
    try:
        keys_list = apikey.list_api_keys()
    except Exception:
        keys_list = []
    endpoints = [
        {"method": "GET", "path": "/api/health", "desc": "Kiểm tra service", "scope": "public"},
        {"method": "POST", "path": "/api/verify", "desc": "Xác thực key", "scope": "verify"},
        {"method": "POST", "path": "/api/info", "desc": "Thông tin key", "scope": "info"},
        {"method": "GET", "path": "/api/tree", "desc": "Cây key", "scope": "info"},
        {"method": "GET", "path": "/api/stats", "desc": "Thống kê", "scope": "admin"},
    ]
    stats = {
        "totalRequests": 0, "todayRequests": 0, "failedRequests": 0,
        "activeApiKeys": sum(1 for k in keys_list if k["active"]),
        "blockedApiKeys": sum(1 for k in keys_list if not k["active"]),
        "totalClients": len(keys_list),
    }
    body = render_template_string(
        API_MANAGER_BODY, me=me, api_keys=keys_list,
        endpoints=endpoints, recent=[], s=stats, test_result=None,
    )
    return page("API", me, body, "api")

@web_bp.route("/api/create", methods=["POST"])
@require_login("admin")
def api_create():
    name = request.form.get("name", "").strip() or "client"
